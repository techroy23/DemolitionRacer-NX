+
+#if defined(AP_SWITCH)
+static sint32 vid_egl_init(void *window)
+{
+    const EGLint config_attributes[] = {
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+        EGL_DEPTH_SIZE, 24, EGL_SAMPLE_BUFFERS, 0,
+        EGL_NONE
+    };
+    const EGLint context_attributes[] = {EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE};
+    EGLConfig config;
+    EGLint count;
+    char log[64];
+
+    vid_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (vid_display == EGL_NO_DISPLAY || !eglInitialize(vid_display, NULL, NULL) ||
+        !eglBindAPI(EGL_OPENGL_ES_API) ||
+        !eglChooseConfig(vid_display, config_attributes, &config, 1, &count) || count == 0)
+        goto fail;
+    vid_surface = eglCreateWindowSurface(vid_display, config, window ? window : nwindowGetDefault(), NULL);
+    if (vid_surface == EGL_NO_SURFACE)
+        goto fail;
+    vid_context = eglCreateContext(vid_display, config, EGL_NO_CONTEXT, context_attributes);
+    if (vid_context == EGL_NO_CONTEXT || !eglMakeCurrent(vid_display, vid_surface, vid_surface, vid_context) ||
+        !eglSwapInterval(vid_display, 1))
+        goto fail;
+    return 1;
+
+fail:
+    snprintf(log, sizeof(log), "Could not initialize EGL/GLES 3 (EGL error 0x%04x)", (unsigned)eglGetError());
+    vid_context_free();
+    xport_message_error("VID EGL", log);
+    return 0;
+}
+#endif
 
